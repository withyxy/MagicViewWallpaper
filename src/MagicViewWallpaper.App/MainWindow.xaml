<Window x:Class="MagicViewWallpaper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MagicView Wallpaper v0.6.4" Width="1260" Height="780" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#0B1115" FontFamily="Microsoft YaHei UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#121B20"/><SolidColorBrush x:Key="Muted" Color="#8FA1A9"/><SolidColorBrush x:Key="Accent" Color="#E6FF59"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F4F8F6"/><Setter Property="Background" Value="#1D292F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#1D292F"/><Setter Property="Foreground" Value="#101510"/><Setter Property="Padding" Value="8,4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#1D292F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#324047"/><Setter Property="Padding" Value="10,6"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0F181D" CornerRadius="18" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="MAGICVIEW" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="12"/><TextBlock Text="Wallpaper" Foreground="White" FontSize="29" FontWeight="Light" Margin="0,3,0,28"/><Button x:Name="LibraryNav" Content="▦  壁纸库" Background="#2B393F" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button x:Name="SettingsNav" Content="⚙  播放设置" HorizontalContentAlignment="Left"/></StackPanel>
   <Border Grid.Row="2" Background="#18242A" CornerRadius="12" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#607078" Margin="0,0,8,0"/><TextBlock x:Name="EngineStatus" Text="引擎未运行" Foreground="White"/></StackPanel><TextBlock x:Name="CurrentName" Text="尚未选择壁纸" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,0,0,0">
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="你的壁纸空间" FontSize="30" Foreground="White" FontWeight="Light"/><TextBlock x:Name="LibrarySummary" Text="正在扫描媒体…" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ImportFiles" Content="＋ 导入壁纸" Background="{StaticResource Accent}" Foreground="#101510" FontWeight="Bold"/><Button x:Name="ImportFolder" Content="导入文件夹"/><Button x:Name="RefreshLibrary" Content="刷新" Margin="0"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="搜索壁纸"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="ApplySelected" Content="应用所选" Background="#24A77A"/><Button x:Name="NextWallpaper" Content="随机下一张" Margin="0"/></StackPanel></Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WallpaperList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
   </Grid>
   <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="播放与切换" FontSize="30" Foreground="White" FontWeight="Light"/><TextBlock Text="保存后立即用于下一次切换" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,26,0,20"><StackPanel><Border Background="{StaticResource Panel}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="自动切换" Foreground="White" FontSize="18"/><TextBlock Text="关闭后保持当前壁纸" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="AutoSwitch" Grid.Column="1" Content="启用" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border><Border Background="{StaticResource Panel}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开机启动" Foreground="White" FontSize="18"/><TextBlock Text="登录 Windows 后自动启动后台壁纸引擎" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="StartupToggle" Grid.Column="1" Content="启用" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
     <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="切换间隔（秒）" Foreground="White" Margin="0,8,0,20"/><TextBox x:Name="IntervalBox" Grid.Column="1" Margin="0,0,0,12"/><TextBlock Grid.Row="1" Text="过渡时间（毫秒）" Foreground="White" Margin="0,8,0,20"/><TextBox x:Name="TransitionBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/><TextBlock Grid.Row="2" Text="画面适配" Foreground="White" Margin="0,8,0,20"/><ComboBox x:Name="FitModeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"><ComboBoxItem Content="铺满裁剪" Tag="Cover"/><ComboBoxItem Content="完整显示" Tag="Contain"/></ComboBox><TextBlock Grid.Row="3" Text="视频帧率" Foreground="White" Margin="0,8,0,0"/><ComboBox x:Name="FpsBox" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="保持源帧率" Tag="0"/><ComboBoxItem Content="60 FPS" Tag="60"/><ComboBoxItem Content="30 FPS" Tag="30"/></ComboBox><TextBlock Grid.Row="4" Text="目标显示器" Foreground="White" Margin="0,20,0,0"/><ComboBox x:Name="MonitorBox" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0"/></Grid></Border>
    </StackPanel></ScrollViewer><WrapPanel Grid.Row="2"><Button x:Name="SaveSettings" Content="保存设置" Background="{StaticResource Accent}" Foreground="#101510" FontWeight="Bold"/><Button x:Name="StopEngine" Content="停止壁纸"/><Button x:Name="ShutdownEngine" Content="退出后台引擎"/><Button x:Name="OpenLogs" Content="打开日志" Margin="0"/></WrapPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
