<Window x:Class="MagicViewWallpaper.App.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="280" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="#FCFCFD" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.28" Color="#111820"/>
            </Border.Effect>
            <Grid Margin="28,23,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="DialogTitle" FontSize="25" FontWeight="SemiBold"
                               Foreground="#252A31" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Content="×" Width="40" Height="40"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="Light"
                            Foreground="#858B94" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Cancel_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,10,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconCircle" Width="42" Height="42" CornerRadius="21"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E4A447">
                        <TextBlock x:Name="DialogIcon" Text="!" Foreground="White" FontSize="26"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DialogMessage" Grid.Column="1" FontSize="17"
                               FontWeight="SemiBold" Foreground="#626770" TextWrapping="Wrap"
                               VerticalAlignment="Center" LineHeight="27"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="取消"
                            Background="#FFFFFF" BorderBrush="#D8DDE4" BorderThickness="1.5"
                            Foreground="#5F6670" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource DialogButton}" Content="确定"
                            Background="#5793EE" BorderThickness="0" Foreground="White"
                            Click="Confirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
